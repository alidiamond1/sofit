# Use either DATABASE_URL or the individual DB_* variables below.
DATABASE_URL=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sofit
DB_USER=root
DB_PASSWORD=

# Enable this when your hosted MySQL provider requires TLS.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Keep this small for serverless deployments to avoid exhausting MySQL connections.
DB_POOL_MAX=3

# How long to wait for MySQL before giving up (ms). Keep it well under the
# function timeout so a slow database renders an error page instead of a 503.
DB_CONNECT_TIMEOUT_MS=8000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=

# Your production domain, for example https://sofit.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ImageKit.io — hosts exercise photos, GIFs, and videos.
# Create a free account, then Dashboard > Developer options > API keys.
# The PUBLIC key is exposed to the browser (NEXT_PUBLIC_); the PRIVATE key is
# server-only (used by /api/imagekit-auth to sign uploads) — never prefix it with NEXT_PUBLIC_.
# Set all three locally and in Vercel.
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
